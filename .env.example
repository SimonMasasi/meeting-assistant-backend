DATABASE_URL = "your_database_url_here"
SECRET_KEY = "your_secret_key_here should at least be 32 characters long for security purposes"
USE_RUSTF_UPLOADS=False
RUSTF_URL="http://localhost:9000"
RUSTF_ACCESS_KEY="your_rustf_access_key_here"
RUSTF_SECRET_KEY="your_rustf_secret_key_here"
RUSTF_BUCKET_NAME="meeting-assistant-uploads"
RUSTF_REGION="us-east-1"

# Cloud transcription + speaker diarization via Soniox (preferred when set)
SONIOX_API_KEY=""
SONIOX_MODEL="stt-async-v5"

# Local transcription fallback (only needed when SONIOX_API_KEY is unset):
# pyannote diarization needs a HuggingFace token; Whisper size: tiny|base|small|medium|large-v3
HUGGINGFACE_TOKEN=""
WHISPER_MODEL="base"

# Summarization: any OpenAI-compatible chat endpoint
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
